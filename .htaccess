RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)/?$ $1.php/ [L]

RewriteCond %{REQUEST_URI} ^/index\.php$
RewriteRule ^(.*)$ / [R=301,L]

php_flag display_startup_errors on
php_flag display_errors on
php_flag html_errors on

RewriteRule ^cambio-de-pantalla-lcd$ servicios.php?id=1 [L,QSA]
RewriteRule ^cambio-de-fep$ servicios.php?id=2 [L,QSA]
RewriteRule ^cambio-de-boquilla$ servicios.php?id=3 [L,QSA]

# Redirigir cualquier otra ruta de servicio con ID dinámico
RewriteRule ^([^/]+)$ servicios.php?name=$1 [L,QSA]